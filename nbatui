#!/bin/bash
# NBA TUI Launcher

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

# Ensure Bun is in PATH
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

echo -e "${YELLOW}Initializing...${NC}"

# 1. Setup Data Service Environment (if missing)
if [ ! -d "data-service/venv" ]; then
    echo "Creating virtual environment..."
    python3 -m venv data-service/venv
fi

# 2. Ensure ascii-animator is installed (for loading screen)
if [ ! -f "data-service/venv/bin/ascii-art-animator" ]; then
    echo "Installing loading animation tools..."
    ./data-service/venv/bin/pip install ascii-animator >/dev/null 2>&1
fi

# 3. Start Data Service (Background)
cd data-service
source venv/bin/activate
# Install requirements only if changed (BUG-10 startup optimization)
REQ_STAMP="../.agent/setup-python.hash"
CURRENT_HASH="$(shasum -a 256 requirements.txt 2>/dev/null | awk '{print $1}')"
[ -z "$CURRENT_HASH" ] && CURRENT_HASH="$(md5 -q requirements.txt 2>/dev/null || true)"
PREV_HASH=""
[ -f "$REQ_STAMP" ] && PREV_HASH="$(cat "$REQ_STAMP" 2>/dev/null || true)"

if [ -n "$CURRENT_HASH" ] && [ "$CURRENT_HASH" != "$PREV_HASH" ]; then
    echo "Updating Python dependencies..."
    pip install -q -r requirements.txt >/dev/null 2>&1
    mkdir -p "../.agent"
    echo "$CURRENT_HASH" > "$REQ_STAMP"
fi

# Clean up existing instance on port 8765 if it belongs to nba-data-service
if lsof -ti:8765 >/dev/null 2>&1; then
    HEALTH_STATUS=$(curl -s --max-time 1 http://localhost:8765/health 2>/dev/null || true)
    if echo "$HEALTH_STATUS" | grep -q "nba-data-service"; then
        lsof -ti:8765 | xargs kill -9 2>/dev/null || true
    fi
fi
# Start
python main.py > /dev/null 2>&1 &
DATA_SERVICE_PID=$!
cd ..

# 4. Start Loading Animation Loop + Background Data Prefetch
# We loop until data service is ready AND data is prefetched
# Give up after ~30s so a broken backend does not hang the launcher forever
WAIT_ROUNDS=0
MAX_WAIT_ROUNDS=60
while true; do
    WAIT_ROUNDS=$((WAIT_ROUNDS + 1))
    if [ "$WAIT_ROUNDS" -gt "$MAX_WAIT_ROUNDS" ]; then
        echo -e "${YELLOW}Data service did not become ready within 30 seconds.${NC}"
        echo -e "${YELLOW}Check the backend manually: cd data-service && python main.py${NC}"
        kill $DATA_SERVICE_PID 2>/dev/null || true
        exit 1
    fi
    # Check if backend is ready first
    if curl -s http://localhost:8765/health > /dev/null 2>&1; then
        # Backend is up! Start prefetching data in background
        curl -s "http://localhost:8765/games/today" > /dev/null 2>&1 &
        curl -s "http://localhost:8765/api/polymarket/odds" > /dev/null 2>&1 &
        curl -s "http://localhost:8765/games/standings" > /dev/null 2>&1 &
        
        # Try to play the loading animation, fallback to text if terminal too small
        if [ -f "src/gif/loading.gif" ]; then
            # Play once (-m 1), very slow (-s very_slow = 1 second per frame)
            # Show errors for debugging
            ./data-service/venv/bin/ascii-art-animator -f src/gif/loading.gif -m 1 -s very_slow -C cyan
            ANIM_EXIT=$?
            if [ $ANIM_EXIT -ne 0 ]; then
                echo -e "${YELLOW}Animation failed (exit code $ANIM_EXIT), using text fallback${NC}"
                echo -e "${CYAN}🏀 Loading NBA TUI...${NC}"
                sleep 2
            fi
        else
            echo -e "${YELLOW}Loading GIF not found${NC}"
            echo -e "${CYAN}🏀 Loading NBA TUI...${NC}"
            sleep 2
        fi
        break
    fi
    
    # Backend not ready yet, short wait
    sleep 0.5
done

clear

# 5. Run TUI
cleanup() {
    echo -e "\n${YELLOW}🛑 Shutting down...${NC}"
    kill $DATA_SERVICE_PID 2>/dev/null || true
    exit 0
}
trap cleanup SIGINT SIGTERM

echo -e "${GREEN}✅ Ready! Starting TUI...${NC}"
sleep 0.5
bun run start

cleanup
