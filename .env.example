# NBA-TUI Configuration

# Data Service URL (used by TUI frontend to communicate with backend)
DATA_SERVICE_URL=http://localhost:8765

# Note: The following settings currently use in-code defaults (port 8765, 30s/300s refresh).
# Uncomment if customizing future releases:
# DATA_SERVICE_PORT=8765
# GAME_REFRESH_INTERVAL_MS=30000
# HEAT_REFRESH_INTERVAL_MS=300000
# ENABLE_SOCIAL_FEATURES=true
